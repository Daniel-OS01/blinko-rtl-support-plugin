# Store repository text files with LF endings.
* text=auto eol=lf

# Preserve conventional Windows endings for native Windows command files.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Common binary file types.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.woff binary
*.woff2 binary
