# Based on https://raw.githubusercontent.com/github/gitignore/main/Node.gitignore
#
# ── Quick-reference: why each project-specific entry is ignored ──────────────
#
# Pattern                              | Reason
# -------------------------------------|----------------------------------------------
# release/                             | Generated by release.yml CI; uploaded as
#                                      | GitHub Release artifact — never commit manually
# release_package/                     | Temp staging dir created inside release.yml
# audit.json                           | Output of 'npm audit --json' in advanced-ci.yml
# package-lock.json                    | Project uses Bun (bun.lockb); npm lock is a
#                                      | CI side-effect of --package-lock-only audit step
# CLAUDE.md / GEMINI.md / AGENTS.md   | AI tool config files — local-only, not plugin
# .cursorrules / .aider*               | source; AI should not sync or modify these
# fixing-plan.md / To-fix-image.jpg   | AI session planning & debugging artefacts
# blinko-docs-en/                      | Upstream Blinko docs — reference only,
# blinko-plugin-examples-and-template/| not plugin source (216 files, untracked)
# server.log / *.log / fix-script.sh  | Runtime logs and one-off utility scripts
# Hebrew RTL Text Direction.user.js   | Companion userscript, reference only —
#                                      | not built/tested/shipped as part of the plugin
#
# ─────────────────────────────────────────────────────────────────────────────

# ── CI-generated release artifacts ──────────────────────────────────────────
# Built and published exclusively by .github/workflows/release.yml.
# Never edit, commit, or regenerate these manually — CI owns them.
release/
release_package/
release.zip

# Generated by the npm audit step in .github/workflows/advanced-ci.yml
audit.json

# ── AI assistant config & planning files ─────────────────────────────────────
# These files guide local AI tooling (Claude Code, Gemini, Cursor, Aider, etc.)
# but are not part of the plugin source. AI should not modify these during
# normal development tasks; git should not track or sync them.
CLAUDE.md
GEMINI.md
AGENTS.md
.cursorrules
.aiderignore
.aider*

# AI-generated planning, debugging, and session artefacts
fixing-plan.md
To-fix-image.jpg

# ── Reference / vendor material (not plugin source) ──────────────────────────
# Blinko documentation and example plugins checked in for local reference only.
# These are upstream repos and should not be modified or tracked here.
blinko-docs-en/
blinko-plugin-examples-and-template/

# ── Package managers ──────────────────────────────────────────────────────────
# This project uses Bun (bun.lockb is the canonical lockfile).
# package-lock.json is a side-effect of running 'npm install --package-lock-only'
# in the CI security audit step and must not be committed.
package-lock.json

# ── Dev server & runtime logs ─────────────────────────────────────────────────
server.log
*.log

# ── One-off utility scripts ───────────────────────────────────────────────────
# Ad-hoc scripts used during development/debugging; not part of the plugin.
fix-script.sh

# ── Related but out-of-scope files ───────────────────────────────────────────
# A companion userscript kept alongside the repo for reference only.
# It is not built, tested, or shipped as part of the Blinko plugin.
Hebrew RTL Text Direction.user.js

# ────────────────────────────────────────────────────────────────────────────

# Logs (Node.gitignore baseline)
# Caches

.cache

# Diagnostic reports (https://nodejs.org/api/report.html)

report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# Runtime data

pids
_.pid
_.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover

lib-cov

# Coverage directory used by tools like istanbul

coverage
*.lcov

# nyc test coverage

.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)

.grunt

# Bower dependency directory (https://bower.io/)

bower_components

# node-waf configuration

.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)

build/Release

# Dependency directories

node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)

web_modules/

# TypeScript cache

*.tsbuildinfo

# Optional npm cache directory

.npm

# Optional eslint cache

.eslintcache

# Optional stylelint cache

.stylelintcache

# Microbundle cache

.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history

.node_repl_history

# Output of 'npm pack'

*.tgz

# Yarn Integrity file

.yarn-integrity

# dotenv environment variable files

.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache (https://parceljs.org/)

.parcel-cache

# Next.js build output

.next
out

# Nuxt.js build / generate output

.nuxt
dist

# Gatsby files

# Comment in the public line in if your project uses Gatsby and not Next.js

# https://nextjs.org/blog/next-9-1#public-directory-support

# public

# vuepress build output

.vuepress/dist

# vuepress v2.x temp and cache directory

.temp

# Docusaurus cache and generated files

.docusaurus

# Serverless directories

.serverless/

# FuseBox cache

.fusebox/

# DynamoDB Local files

.dynamodb/

# TernJS port file

.tern-port

# Stores VSCode versions used for testing VSCode extensions

.vscode-test

# yarn v2

.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store
